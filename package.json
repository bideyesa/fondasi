{
    "name": "fondasi",
    "version": "1.0.0",
    "description": "Academic-focused UI design system for Hotumese SIMPATTI applications",
    "author": "Bideyesa",
    "license": "MIT",
    "main": "./dist/fondasi.js",
    "style": "./dist/fondasi.css",
    "exports": {
        ".": "./dist/fondasi.js",
        "./dist/fondasi.css": "./dist/fondasi.css",
        "./dist/fondasi.min.css": "./dist/fondasi.min.css"
    },
    "files": [
        "dist",
        "!dist/*.map"
    ],
    "sideEffects": [
        "dist/fondasi.css",
        "dist/fondasi.min.css"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --mode minify && sass src/scss/app.scss dist/fondasi.css && sass src/scss/app.scss dist/fondasi.min.css --style compressed",
        "build:watch": "vite build --watch",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm test && npm run build"
    },
    "devDependencies": {
        "sass": "^1.99.0",
        "vite": "^8.0.0",
        "vitest": "^2.0.0",
        "jsdom": "^24.0.0",
        "@vitest/coverage-v8": "^2.0.0"
    },
    "keywords": [
        "ui",
        "component-library",
        "design-system",
        "academic",
        "vanilla-js"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/bideyesa/fondasi"
    },
    "bugs": {
        "url": "https://github.com/bideyesa/fondasi/issues"
    },
    "homepage": "https://github.com/bideyesa/fondasi#readme",
    "engines": {
        "node": ">=18"
    }
}
